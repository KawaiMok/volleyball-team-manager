# 畫面顯示時區（IANA；伺服端 Vercel 預設 UTC，未設會誤顯示時間）
# NEXT_PUBLIC_DISPLAY_TIMEZONE=Asia/Taipei

# Clerk（https://dashboard.clerk.com → API Keys）
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Postgres（本機：請建立同名資料庫 volleyball_team，或執行 npm run db:create）
# 範例（請替換密碼；EnterpriseDB 預設使用者常為 postgres，埠 5432）
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/volleyball_team?schema=public"

# Neon 等雲端 DB：App 執行時用 pooled URL（hostname 含 -pooler）；migrate 用 direct URL（去掉 -pooler）
# DATABASE_URL="postgresql://USER:PASS@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://USER:PASS@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# 僅開發：允許 POST /api/bootstrap、claim、onboarding 示範按鈕（上線請勿開）
# 正式環境會強制關閉：Vercel Production（VERCEL_ENV=production）或 APP_ENV=production
ALLOW_BOOTSTRAP=0
# APP_ENV=production

# Capacitor 行動殼：覆寫載入的 Web 站網址（僅在執行 `mobile/` 內 `npx cap sync` 等指令時讀取；勿把正式機密放在前端）
# CAPACITOR_SERVER_URL=https://your-domain.com

# App 內推播註冊（預設關閉）。Android 須先放好 Firebase `google-services.json` 再設為 true，否則可能登入後閃退。
# NEXT_PUBLIC_ENABLE_NATIVE_PUSH=true

# 伺服端 FCM 發送（擇一：三欄位 或 整段 JSON；勿提交到 Git）
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_SERVICE_ACCOUNT_JSON=


# AI 訓練計畫（POST .../training-plan/ai）— DeepSeek（OpenAI 相容 API）
# 取得：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# 模型（預設 deepseek-v4-flash；另可改 deepseek-chat、deepseek-reasoner 等）
DEEPSEEK_MODEL=deepseek-v4-flash
# 選用：API 基底（預設 https://api.deepseek.com）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 每隊每小時 AI 呼叫上限（預設 30）
# AI_RATE_LIMIT_PER_TEAM_PER_HOUR=30

# 僅開發：允許 x-debug-* header／cookie 繞過 Clerk（呼叫 API 腳本時）
# 正式環境會強制關閉：Vercel Production 或 APP_ENV=production
# ALLOW_DEBUG_AUTH=true

# 推播測試 API（POST /api/me/push-test）；正式環境預設關閉，必要時設 ALLOW_PUSH_TEST=1
# ALLOW_PUSH_TEST=0

# 平台超管 Email（逗號分隔；與 PlatformAdmin 資料表互補，方便首次開通）
# PLATFORM_ADMIN_EMAILS=you@example.com
